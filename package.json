{
  "name": "ezstat-mcp-server",
  "version": "0.8.0",
  "description": "Model Context Protocol server for EzStat — let AI agents push and read your metrics natively.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ezstat-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "smithery.yaml",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ezstat",
    "metrics",
    "ai-agent",
    "claude",
    "cursor",
    "observability",
    "stathat",
    "ai-agents"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.13.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2",
    "tsx": "^4.19.1",
    "vitest": "^2.1.1"
  },
  "mcp": {
    "name": "ezstat",
    "displayName": "EzStat",
    "description": "Push and read metrics with EzStat from any AI agent. Track counters and values, then ask natural-language questions over your production telemetry.",
    "homepage": "https://ezstat.dev",
    "version": "0.8.0",
    "transport": "stdio",
    "hostedEndpoint": "https://mcp.ezstat.dev",
    "tools": [
      "track_metric",
      "ask_ezstat",
      "read_stat",
      "list_stats"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clira-dev/ezstat-mcp-server.git"
  },
  "homepage": "https://ezstat.dev",
  "bugs": {
    "url": "https://github.com/clira-dev/ezstat-mcp-server/issues"
  },
  "mcpName": "dev.ezstat/ezstat-mcp-server"
}
