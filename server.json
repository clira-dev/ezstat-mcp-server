{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.ezstat/ezstat-mcp-server",
  "description": "Track and query EzStat metrics from Claude, Cursor, or any MCP agent. StatHat-compatible.",
  "repository": {
    "url": "https://github.com/clira-dev/ezstat-mcp-server",
    "source": "github"
  },
  "version": "0.8.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.ezstat.dev",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <your EzStat API key> (get one at https://ezstat.dev)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "ezstat-mcp-server",
      "version": "0.8.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EZSTAT_API_KEY",
          "description": "Your EzStat API key (get one at https://ezstat.dev)",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "EZSTAT_BASE_URL",
          "description": "EzStat base URL (default https://ezstat.dev)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ],
  "websiteUrl": "https://ezstat.dev"
}
