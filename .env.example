# EzStat API key (the "ezkey"). Get one from https://ezstat.dev
# Required. Never commit a real key.
EZSTAT_API_KEY=

# EzStat base URL. Defaults to https://api.ezstat.dev — override for staging / self-hosted.
EZSTAT_BASE_URL=https://api.ezstat.dev

# Optional: per-request timeout in milliseconds (default 10000)
# EZSTAT_TIMEOUT_MS=10000

# Optional: explicit Ask-Your-Data base path. Defaults to the host's /api/v1/query
# EZSTAT_QUERY_PATH=/api/v1/query
